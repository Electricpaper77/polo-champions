# Local development
VITE_WEBSOCKET_URL=ws://localhost:8080

# Vercel staging/production builds must set this to the Render WebSocket URL.
# Example: VITE_WEBSOCKET_URL=wss://polo-champions-realtime-staging.onrender.com

# Render realtime server
NODE_ENV=production
PORT=8080
WS_ALLOWED_ORIGINS=https://your-vercel-staging-domain.vercel.app
MAX_CONNECTIONS=200
MAX_ACTIVE_ROOMS=100
MAX_PENDING_LOBBIES=100
MAX_WS_MESSAGE_BYTES=8192
